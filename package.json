{
  "name": "quantum-janitor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && npm run check:i18n && tsc --noEmit && vite build",
    "preview": "vite preview",
    "validate": "tsx tools/validate-content.ts",
    "typecheck": "tsc --noEmit",
    "playthrough": "tsx tools/playthrough.ts",
    "bake:portraits": "tsx tools/bake-portraits.ts",
    "check:tap": "tsx tools/tap-check.ts",
    "check:i18n": "tsx tools/i18n-hardcoded.ts && tsx tools/i18n-content.ts",
    "i18n": "tsx tools/i18n-content.ts"
  },
  "dependencies": {
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "inkjs": "^2.4.0",
    "phaser": "^3.90.0",
    "talking-portrait": "file:../talking-portrait",
    "three": "^0.186.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
